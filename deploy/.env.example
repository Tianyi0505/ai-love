# LLM（Anthropic 兼容网关）
ANTHROPIC_AUTH_TOKEN=replace-with-anthropic-compatible-token
ANTHROPIC_BASE_URL=https://tokendance.space/gateway
TOKENDANCE_HOST_IP=replace-with-gateway-host-ip

# 图片理解（Anthropic Messages 兼容接口）
VISION_BASE_URL=https://tokendance.space/gateway/v1/messages
VISION_MODEL=minimax-m3

# 其他可选 LLM Provider（仅启用对应 provider 时需要）
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://host.docker.internal:11434

# TTS Provider
GPT_SOVITS_URL=http://host.docker.internal:9880
MIMO_BASE_URL=https://tokendance.space/gateway/v1
MIMO_MODEL=mimo-v2.5-tts-voiceclone
MIMO_REF_AUDIO=/app/data/voice/reference.wav
AZURE_SPEECH_KEY=replace-with-azure-speech-key
AZURE_SPEECH_REGION=eastasia

# 本地外部服务（按实际拓扑填写）
NAPCAT_WS_URL=ws://host.docker.internal:3001
NAPCAT_HTTP_URL=http://host.docker.internal:3000

# 和风天气 MCP（API Host 在和风天气控制台“设置”中查看）
QWEATHER_API_KEY=replace-with-qweather-api-key
QWEATHER_CREDENTIAL_ID=replace-with-credential-id
QWEATHER_API_HOST=replace-with-your-api-host.qweatherapi.com

# NATS（必填）
AILOVE_BUS_URL=nats://replace-with-nats-host:4222
AILOVE_BUS_TOKEN=replace-with-random-nats-token

# Nacos 鉴权（必填）
NACOS_AUTH_IDENTITY_KEY=replace-with-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-identity-value
NACOS_AUTH_TOKEN=replace-with-base64-auth-token

# 服务注册
AILOVE_NACOS_ADDRS=127.0.0.1:8848
AILOVE_NACOS_USER=replace-with-nacos-user
AILOVE_NACOS_PASSWORD=replace-with-nacos-password

# PostgreSQL（动态领域状态 + pgvector）
AILOVE_POSTGRES_PASSWORD=replace-with-postgres-password
AILOVE_DATABASE_URL=postgresql://ailove:replace-with-postgres-password@postgres:5432/ailove
