# 配置对话模型密钥（模型名称和地址在 Nacos 的 ailove.config/llm.models 中维护）
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=replace-with-openai-api-key
AGNES_API_KEY=replace-with-agnes-api-key
TOKENDANCE_HOST_IP=replace-with-gateway-host-ip

# 配置图片理解接口（阿里云百炼 DashScope）
BAILIAN_API_KEY=replace-with-bailian-api-key

# 配置可选的本地模型服务
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 配置语音合成提供者
ANTHROPIC_AUTH_TOKEN=replace-with-mimo-compatible-token
GPT_SOVITS_URL=http://host.docker.internal:9880
MIMO_BASE_URL=https://tokendance.space/gateway/v1
MIMO_MODEL=mimo-v2.5-tts-voiceclone
MIMO_REF_AUDIO=/app/data/voice/reference.wav
AZURE_SPEECH_KEY=replace-with-azure-speech-key
AZURE_SPEECH_REGION=eastasia

# 配置外部服务地址
NAPCAT_WS_URL=ws://host.docker.internal:3001
NAPCAT_HTTP_URL=http://host.docker.internal:3000
OBS_WS_URL=ws://host.docker.internal:4455
MCP_URL=http://mcp:8011/mcp

# 配置 QQ 与直播账号
AILOVE_AI_ID=ai_luoyu
AILOVE_AGENT_CONFIG_FILE=nacos/agent.ai_luoyu.yaml
AILOVE_PERSONAL_BOOTSTRAP_SQL=./private/sql/bootstrap.sql
AILOVE_VOICE_REF_AUDIO_PATH=/sounds/replace-with-reference-audio.wav
AILOVE_VOICE_REF_TEXT=replace-with-reference-text
AILOVE_QQ_WHITELIST=[123456789]
AILOVE_QQ_UIN=123456789
AILOVE_BILIBILI_STREAM_KEY=replace-with-bilibili-stream-key

# 配置和风天气 MCP
QWEATHER_API_KEY=replace-with-qweather-api-key
QWEATHER_API_HOST=replace-with-your-api-host.qweatherapi.com

# 配置 NATS
AILOVE_BUS_URL=nats://replace-with-nats-host:4222
AILOVE_BUS_TOKEN=replace-with-random-nats-token

# 配置 ai-love 面板与 Redis 会话
AILOVE_REDIS_URL=redis://redis:6379/0
AILOVE_REDIS_PASSWORD=replace-with-random-redis-password
NAPCAT_WEBUI_TOKEN=replace-with-napcat-webui-token
PANEL_INITIAL_USERNAME=replace-with-panel-username
PANEL_INITIAL_PASSWORD=replace-with-panel-password
PANEL_PEOPLE_MEMORY_LIMIT=300

# 配置 Nacos 鉴权
NACOS_AUTH_IDENTITY_KEY=replace-with-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-identity-value
NACOS_AUTH_TOKEN=replace-with-base64-auth-token

# 配置服务注册
AILOVE_SNOWFLAKE_WORKER_ID=0
AILOVE_NACOS_ADDRS=127.0.0.1:8848
AILOVE_NACOS_USER=replace-with-nacos-user
AILOVE_NACOS_PASSWORD=replace-with-nacos-password
AILOVE_NACOS_GROUP=DEFAULT_GROUP
AILOVE_NACOS_HTTP_TIMEOUT_SEC=10
AILOVE_NACOS_GRPC_TIMEOUT_MS=5000
AILOVE_CONFIG_RETRY_COUNT=5
AILOVE_CONFIG_RETRY_INTERVAL_SEC=2

# 配置 PostgreSQL
AILOVE_POSTGRES_PASSWORD=replace-with-postgres-password
AILOVE_DATABASE_URL=postgresql://ailove:replace-with-postgres-password@postgres:5432/ailove
AILOVE_DATABASE_POOL_MIN_SIZE=1
AILOVE_DATABASE_POOL_MAX_SIZE=10
AILOVE_DATABASE_POOL_RECYCLE_SEC=300
AILOVE_DATABASE_POOL_TIMEOUT_SEC=30
