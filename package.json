{
  "name": "dsh-luoyu",
  "version": "0.1.0",
  "description": "Run a personalized QQ bot named Luoyu through DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qq",
    "napcat",
    "onebot",
    "chatbot",
    "qq-bot"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "client.js"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
