{
  "id": "models",
  "name": "Chat Models",
  "description": "Provides model adapters through the public factory contract.",
  "host": "ai-agent",
  "category": "model",
  "entrypoint": "plugins.factories:ModelFactoryPlugin",
  "provides": [
    "model.factory"
  ],
  "requires": [],
  "enabled": true,
  "config": {
    "implementations": {
      "openai": "shared.chat_model_strategy:OpenAIChatModelStrategy",
      "anthropic": "shared.chat_model_strategy:AnthropicChatModelStrategy",
      "deepseek": "shared.chat_model_strategy:DeepSeekChatModelStrategy",
      "agnes": "shared.chat_model_strategy:AgnesChatModelStrategy"
    }
  }
}
